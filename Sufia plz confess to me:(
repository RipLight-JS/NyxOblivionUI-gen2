        elseif waypoints[wname] then
            root.CFrame = waypoints[wname]
            UI:Notify("Waypoint", "Returned to '" .. wname .. "'", 2)
        else
            UI:Notify("Waypoint", "No waypoint named '" .. wname .. "'", 2)
        end
    end})


                BackgroundColor3 = Theme.Accent, Parent = row}, {Corner(8)})
            b.MouseButton1Click:Connect(function() if callback then task.spawn(callback) end end)
            return b
        end

        function S:AddToggle(text, desc, default, callback)
            return MakeToggle(Row(card, text, desc), default or false, callback)
        end

        -- onRelease = true: callback fires when you let go (used for UI scale so the slider doesn't jump under your finger)
        function S:AddSlider(text, desc, min, max, default, callback, onRelease, suffix)
            local row = Row(card, text, desc)
            suffix = suffix or ""
            local value = default or min
            local track = New("Frame", {Size = UDim2.new(0.26, 0, 0, 5), Position = UDim2.new(0.52, 0, 0.5, -2),
                BackgroundColor3 = Theme.Off, Parent = row}, {Corner(3)})
            local fill = New("Frame", {Size = UDim2.fromScale((value - min) / (max - min), 1), BackgroundColor3 = Theme.Accent,
                Parent = track}, {Corner(3)})
            New("Frame", {Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                BackgroundColor3 = Theme.Text, Parent = fill}, {Corner(6)})
            local box = Label({Text = value .. suffix, Font = Theme.FontBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center,
                Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -50, 0.5, -11), Parent = row})
            box.BackgroundTransparency = 0; box.BackgroundColor3 = Theme.Bg; Corner(7).Parent = box
            local dragging = false
            local function update(x)
                local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * a + 0.5)
                fill.Size = UDim2.fromScale(a, 1); box.Text = value .. suffix
                if callback and not onRelease then task.spawn(callback, value) end
            end
            track.InputBegan:Connect(function(i) if IsPress(i) then dragging = true; update(i.Position.X) end end)
            lib:Bind(UserInputService.InputChanged, function(i) if dragging and IsMove(i) then update(i.Position.X) end end)
            lib:Bind(UserInputService.InputEnded, function(i)
                if dragging and IsPress(i) then
                    dragging = false
                    if callback and onRelease then task.spawn(callback, value) end
                end
            end)
            local Sl = {}
            function Sl:Set(v)
                value = math.clamp(v, min, max)
                fill.Size = UDim2.fromScale((value - min) / (max - min), 1); box.Text = value .. suffix
            end
            return Sl
        end

        function S:AddDropdown(text, desc, options, default, callback)
            local row = Row(card, text, desc)
            local idx = table.find(options, default) or 1
            local b = Button({Text = options[idx], TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(92, 24),
                Position = UDim2.new(1, -100, 0.5, -12), BackgroundColor3 = Theme.Bg, Parent = row},
                {Corner(8), Stroke(), Pad(10, 0, 24, 0)})
            local dd = MakeIcon("chevDown", row, 12, Theme.SubText)
            dd.Frame.Position = UDim2.new(1, -26, 0.5, -6)
            b.MouseButton1Click:Connect(function()
                idx = idx % #options + 1
                b.Text = options[idx]
                if callback then task.spawn(callback, options[idx]) end
            end)
        end

        function S:AddKeybind(text, desc, default, callback)
            local row = Row(card, text, desc)
            local b = Button({Text = default.Name, TextColor3 = Theme.Accent2, Size = UDim2.fromOffset(92, 24),
                Position = UDim2.new(1, -100, 0.5, -12), BackgroundColor3 = Theme.Bg, Parent = row},
                {Corner(8), Stroke(Theme.Accent, 1, 0.2)})
            b.MouseButton1Click:Connect(function()
                b.Text = "..."
                local c; c = UserInputService.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.Keyboard then
                        b.Text = i.KeyCode.Name; c:Disconnect()
                        if callback then task.spawn(callback, i.KeyCode) end
                    end
                end)
            end)
        end

        function S:AddLabel(text)
            return Label({Text = text, TextSize = 11, TextColor3 = Theme.SubText, TextWrapped = true,
                Size = UDim2.new(1, 0, 0, 16), Parent = card})
        end
        return S
    end
    return Tab
end

-- ================= COMMANDS =================
local CATEGORIES = {"All", "Movement", "Character", "Protection", "Players", "Visuals", "System", "Troll"}

function Library:AddCommand(def)
    def.Kind = def.Kind or "Open"
    def.Category = def.Category or "System"
    table.insert(self.Commands, def)
    if self.RenderCommands then self:RenderCommands() end
end

function Library:RunCommand(text)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if text:sub(1, #self.Prefix) == self.Prefix then text = text:sub(#self.Prefix + 1) end
    local args = {}
    for w in text:gmatch("%S+") do table.insert(args, w) end
    local name = table.remove(args, 1)
    if not name then return end
    for _, c in ipairs(self.Commands) do
        if c.Name:lower():gsub("%s", "") == name:lower() then
            if c.Kind == "Toggle" then
                c.State = not c.State
                if c.Callback then task.spawn(c.Callback, c.State) end
                self:Notify(c.Name, c.State and "Enabled" or "Disabled", 2)
                if self.RenderCommands then self:RenderCommands() end
            else
                if c.Callback then task.spawn(c.Callback, unpack(args)) end
                self:Notify(c.Name, "Executed", 2)
            end
            if self.Log then self.Log(c.Name .. " " .. table.concat(args, " ")) end
            return
        end
    end
    self:Notify("Unknown command", name, 2)
end

function Library:BuildCommandsTab()
    local lib = self
    local tab = self:AddTab("Cmds", "terminal", {Footer = true})
    local scroll = tab.Scroll
    local current = "All"

    -- category chips (horizontal scroller, first item)
    local chipBar = New("ScrollingFrame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), LayoutOrder = 0,
        ScrollingDirection = Enum.ScrollingDirection.X, Parent = scroll}, {List(5, Enum.FillDirection.Horizontal)})
    local chips = {}
    for _, cat in ipairs(CATEGORIES) do
        local c = Button({Text = cat, TextSize = 11, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26),
            BackgroundColor3 = Theme.Row, Parent = chipBar}, {Corner(13), Pad(11, 0), Stroke()})
        c.MouseButton1Click:Connect(function() current = cat; lib:RenderCommands() end)
        chips[cat] = c
    end

    -- command bar
    local box = New("TextBox", {Text = "", PlaceholderText = "Type a command...", PlaceholderColor3 = Theme.SubText,
        Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text, ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -44, 1, 0), Parent = tab.Footer})
    local ti = MakeIcon("terminal", tab.Footer, 16, Theme.Accent2)
    ti.Frame.Position = UDim2.fromOffset(10, 9)
    box.FocusLost:Connect(function(enter)
        if enter and box.Text ~= "" then lib:RunCommand(box.Text); box.Text = "" end
    end)
    self.CommandBox = box

    function self:RenderCommands()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") and c.Name == "CmdRow" then c:Destroy() end
        end
        for cat, c in pairs(chips) do
            local a = (cat == current)
            c.BackgroundColor3 = a and Theme.Accent or Theme.Row
        end
        local order = 1
        for pass = 1, 2 do
            for _, def in ipairs(self.Commands) do
                if (pass == 1) == (def.Best == true) and (current == "All" or def.Category == current) then
                    local row = Row(scroll, def.Name, "/" .. def.Name:lower():gsub("%s", "") .. "  " .. (def.Desc or ""), 42)
                    row.Name = "CmdRow"; row.LayoutOrder = order; order += 1
                    row:FindFirstChildOfClass("TextLabel").Size = UDim2.new(0.6, -50, 0, 16)
                    if def.Best then
                        Label({Text = "BEST", Font = Theme.FontBold, TextSize = 8, TextColor3 = Theme.Accent2,
                            TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(30, 12),
                            Position = UDim2.new(0.6, -38, 0, 8), BackgroundTransparency = 0,
                            BackgroundColor3 = Theme.Row, Parent = row}, {Corner(6)})
                    end
                    if def.Kind == "Toggle" then
                        MakeToggle(row, def.State or false, function(v) def.State = v; if def.Callback then def.Callback(v) end end)
                    else
                        local b = Button({Text = def.Kind, TextSize = 11, Size = UDim2.fromOffset(52, 24),
                            Position = UDim2.new(1, -60, 0.5, -12), BackgroundColor3 = Theme.Accent, Parent = row}, {Corner(8)})
                        b.MouseButton1Click:Connect(function()
                            if def.Callback then task.spawn(def.Callback) end
                            if lib.Log then lib.Log(def.Name) end
                        end)
                    end
                end
            end
        end
    end
    self:RenderCommands()
    return tab
end


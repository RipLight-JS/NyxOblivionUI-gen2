function Library:BuildSettingsTab()
    local lib = self
    local tab = self:AddTab("Settings", "gear")

    local ui = tab:AddSection("Interface")
    self.ScaleSlider = ui:AddSlider("UI Scale", "Size of the whole menu", 40, 160, math.floor(self.Scale * 100 + 0.5),
        function(v) lib:SetScale(v / 100) end, true, "%")
    ui:AddButton("Auto fit screen", "Reset scale to fit your device", "Auto", function()
        lib:SetScale(lib.AutoScale); lib.ScaleSlider:Set(math.floor(lib.AutoScale * 100 + 0.5))
    end)
    ui:AddToggle("Open Nyx button", "Show / hide the menu from the screen", true, function(v) lib.FloatBtn.Visible = v end)
    ui:AddButton("Reset window position", "Bring the menu back to the top", "Reset", function() lib:ResetPosition() end)

    local gen = tab:AddSection("General")
    gen:AddKeybind("Toggle menu key", "Hide or show the menu", self.ToggleKey, function(k) lib.ToggleKey = k end)
    gen:AddDropdown("Command prefix", "Opens the command bar", {";", ".", "/", ","}, ";", function(v) lib.Prefix = v end)
    gen:AddToggle("Anti idle", "Never get the 20-minute idle kick", false, function(v)
        if v then
            lib.IdleConn = LocalPlayer.Idled:Connect(function()
                pcall(function()
                    local vu = game:GetService("VirtualUser")
                    vu:CaptureController(); vu:ClickButton2(Vector2.new())
                end)
            end)
        elseif lib.IdleConn then lib.IdleConn:Disconnect(); lib.IdleConn = nil end
    end)
    gen:AddButton("Unload", "Close the menu and stop everything", "Unload", function() lib.Gui:Destroy() end)
    return tab
end


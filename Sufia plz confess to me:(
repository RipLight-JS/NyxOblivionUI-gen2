    local search = New("TextBox", {Text = "", PlaceholderText = "Search players...", PlaceholderColor3 = Theme.SubText,
        Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text, ClearTextOnFocus = false, LayoutOrder = 0,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.2,
        Size = UDim2.new(1, 0, 0, 30), Parent = scroll}, {Corner(15), Stroke(), Pad(32, 0, 12, 0)})
    local si = MakeIcon("search", search, 14, Theme.SubText)
    si.Frame.Position = UDim2.fromOffset(-22, 8)

    local actions = {"Goto", "View", "Mute", "Copy"}
    local rows = {}

    local function filter()
        local q = search.Text:lower()
        for _, r in ipairs(rows) do
            local p = r.Player
            r.Frame.Visible = q == "" or p.Name:lower():find(q, 1, true) ~= nil or p.DisplayName:lower():find(q, 1, true) ~= nil

                local b = Button({Text = a, TextSize = 11, Size = UDim2.new(1 / #actions, -5, 1, 0), BackgroundColor3 = Theme.Bg,
                    Parent = bar}, {Corner(8), Stroke()})
                b.MouseButton1Click:Connect(function()
                    local fn = lib.PlayerActions[a]
                    if fn then task.spawn(fn, p)
                    elseif a == "Copy" then CopyText(p.Name); lib:Notify("Copied", p.Name, 2)
                    else lib:Notify(a, "No action bound. Set UI.PlayerActions." .. a, 3) end
                end)
            end
            local open = false
            head.MouseButton1Click:Connect(function()
                open = not open
                Tween(arrow.Frame, 0.2, {Rotation = open and 180 or 0})
                Tween(f, 0.2, {Size = UDim2.new(1, 0, 0, open and 82 or 40)})
            end)
            table.insert(rows, {Frame = f, Player = p})
        end
        filter()
    end
    search:GetPropertyChangedSignal("Text"):Connect(filter)
    self:Bind(Players.PlayerAdded, function() task.wait(0.2); refresh() end)
    self:Bind(Players.PlayerRemoving, function() task.defer(refresh) end)
    refresh()
    return tab
end


            local av = New("ImageLabel", {Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(8, 6),
                BackgroundColor3 = Theme.Bg, Parent = head}, {Corner(14)})
            task.spawn(function()
                local ok, img = pcall(Players.GetUserThumbnailAsync, Players, p.UserId,
                    Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                if ok and av.Parent then av.Image = img end
            end)
            Label({Text = p.DisplayName .. (p == LocalPlayer and "  (you)" or ""), Font = Theme.FontBold,
                Position = UDim2.fromOffset(44, 4), Size = UDim2.new(1, -80, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = head})
            Label({Text = "@" .. p.Name, TextSize = 10, TextColor3 = Theme.SubText, Position = UDim2.fromOffset(44, 20),
                Size = UDim2.new(1, -80, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head})
            local arrow = MakeIcon("chevDown", head, 14, Theme.SubText):Center()
            arrow.Frame.Position = UDim2.new(1, -18, 0, 20)

            local bar = New("Frame", {Position = UDim2.fromOffset(8, 44), Size = UDim2.new(1, -16, 0, 30), BackgroundTransparency = 1,
                Parent = f}, {New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6)})})

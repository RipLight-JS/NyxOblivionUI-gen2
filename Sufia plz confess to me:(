                    local row = New("Frame", {Name = "CmdRow", Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Row,
                        BackgroundTransparency = 0.5, LayoutOrder = order, Parent = scroll}, {Corner(10), Stroke(Theme.Stroke, 1, 0.65)})

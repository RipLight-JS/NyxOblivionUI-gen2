local function MakeIcon(name, parent, size, color)
    size = size or 16
    color = color or Theme.Text
    local holder = New("Frame", {Name = "Icon_" .. name, Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1, Parent = parent})
    local obj = {Frame = holder}
    function obj:Center()
        holder.AnchorPoint = Vector2.new(0.5, 0.5)
        holder.Position = UDim2.fromScale(0.5, 0.5)
        return obj
    end

    local asset = USE_IMAGE_ICONS and IconAssets[name]
    if asset then
        local img = New("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = asset,
            ImageColor3 = color, Parent = holder})
        function obj:SetColor(c) img.ImageColor3 = c end
        return obj
    end

    local root = New("Frame", {Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = holder})
    New("UIScale", {Scale = size / 24, Parent = root})
    local T = size <= 13 and 2.1 or 1.75 -- stroke width on the 24 grid (a bit heavier when tiny)
    local fills, strokes = {}, {}

    ---------- drawing primitives ----------
    local function Seg(x1, y1, x2, y2)
        local dx, dy = x2 - x1, y2 - y1
        table.insert(fills, New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + T, T),
            Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = color, BorderSizePixel = 0,
            Parent = root}, {Corner(T / 2)}))
    end
    local function Poly(pts, closed)
        for i = 1, #pts - 1 do Seg(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2]) end
        if closed then Seg(pts[#pts][1], pts[#pts][2], pts[1][1], pts[1][2]) end
    end
    local function Line(x1, y1, x2, y2) Seg(x1, y1, x2, y2) end
    local function Arc(cx, cy, r, a0, a1, n)
        n = n or math.max(6, math.ceil(math.abs(a1 - a0) / 15))
        local pts = {}
        for i = 0, n do
            local a = math.rad(a0 + (a1 - a0) * i / n)
            pts[#pts + 1] = {cx + r * math.cos(a), cy + r * math.sin(a)}
        end
        return pts
    end
    local function Bez(p0, p1, p2, p3, n)
        n = n or 10
        local pts = {}
        for i = 0, n do
            local t = i / n
            local u = 1 - t
            pts[#pts + 1] = {
                u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1],
                u * u * u * p0[2] + 3 * u * u * t * p1[2] + 3 * u * t * t * p2[2] + t * t * t * p3[2]}
        end
        return pts
    end
    local function Join(...)
        local out = {}
        for _, list in ipairs({...}) do
            for _, pt in ipairs(list) do out[#out + 1] = pt end
        end
        return out
    end
    -- outline circle / rounded box: stroke is centred on the shape edge like a real vector stroke
    local function Circle(cx, cy, r)
        local f = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy),
            Size = UDim2.fromOffset(2 * r - T, 2 * r - T), BackgroundTransparency = 1, Parent = root}, {Corner(r)})
        table.insert(strokes, New("UIStroke", {Color = color, Thickness = T,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f}))
    end
    local function RBox(x, y, w, h, r)
        local f = New("Frame", {Position = UDim2.fromOffset(x + T / 2, y + T / 2),
            Size = UDim2.fromOffset(w - T, h - T), BackgroundTransparency = 1, Parent = root}, {Corner(r or 0)})
        table.insert(strokes, New("UIStroke", {Color = color, Thickness = T,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f}))
    end
    local function Fill(x, y, w, h, r)
        table.insert(fills, New("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = color, BorderSizePixel = 0, Parent = root}, {Corner(r or 0)}))
    end
    local function Tri(x, y, w, h, left) -- filled triangle built from thin slices
        local n = 16
        local sw = w / n
        for i = 0, n - 1 do
            local frac = left and (i + 1) / n or 1 - i / n
            Fill(x + i * sw, y + (h - h * frac) / 2, sw + 0.6, h * frac)
        end
    end

    ---------- the icons ----------
    local D = {}
    D.grid = function() -- dashboard
        RBox(3, 3, 7, 9, 1.5); RBox(14, 3, 7, 5, 1.5); RBox(14, 12, 7, 9, 1.5); RBox(3, 16, 7, 5, 1.5)
    end
    D.terminal = function()
        Poly({{4, 17}, {10, 11}, {4, 5}}); Line(12, 19, 20, 19)
    end
    D.users = function()
        Circle(9, 7, 4)
        Poly(Join({{3, 21}, {3, 19}}, Arc(7, 19, 4, 180, 270, 6), {{11, 15}}, Arc(11, 19, 4, 270, 360, 6), {{15, 21}}))
        Poly(Arc(17, 7, 4, -104.5, 104.5, 12))
        Poly(Join({{22, 21}, {22, 19}}, Arc(18, 19, 4, 0, -75.5, 8)))
    end
    D.user = function()
        Circle(12, 8, 4)
        Poly(Join({{4, 21}, {4, 19}}, Arc(8, 19, 4, 180, 270, 6), {{16, 15}}, Arc(16, 19, 4, 270, 360, 6), {{20, 21}}))
    end
    D.music = function()
        Poly({{9, 18}, {9, 5}, {21, 3}, {21, 16}}); Circle(6, 18, 3); Circle(18, 16, 3)
    end
    D.bell = function()
        Poly(Join(Arc(12, 8, 6, 180, 360, 12), Bez({18, 8}, {18, 15}, {21, 17}, {21, 17}),
            {{3, 17}}, Bez({3, 17}, {3, 17}, {6, 15}, {6, 8})))
        local c = {}
        for i = -8, 8 do
            local x = 1.7 * i / 8
            c[#c + 1] = {12 + x, 20.07 + math.sqrt(1.94 * 1.94 - x * x)}
        end
        Poly(c)
    end
    D.gear = function()
        local pts = {}
        local function P(a, r)
            pts[#pts + 1] = {12 + r * math.cos(math.rad(a)), 12 + r * math.sin(math.rad(a))}
        end
        for k = 0, 5 do
            local c = k * 60 - 90
            P(c - 30, 7.9)
            P(c - 20, 7.9)
            P(c - 12, 10)
            P(c + 12, 10)
            P(c + 20, 7.9)
        end
        Poly(pts, true)
        Circle(12, 12, 3)
    end
    D.chevDown = function() Poly({{6, 9}, {12, 15}, {18, 9}}) end
    D.close    = function() Line(18, 6, 6, 18); Line(6, 6, 18, 18) end
    D.minus    = function() Line(5, 12, 19, 12) end
    D.search   = function() Circle(11, 11, 8); Line(21, 21, 16.65, 16.65) end
    D.play     = function() Tri(6, 3, 14, 18) end
    D.pause    = function() Fill(6, 4, 4, 16, 1.5); Fill(14, 4, 4, 16, 1.5) end
    D.next     = function() Tri(5, 4, 10, 16); Fill(17, 4, 2.5, 16, 1) end
    D.prev     = function() Fill(4.5, 4, 2.5, 16, 1); Tri(9, 4, 10, 16, true) end
    D.copy     = function()
        RBox(8, 8, 14, 14, 2)
        Poly({{4, 16}, {3.2, 15.7}, {2.3, 14.8}, {2, 14}, {2, 4}, {2.3, 3.2}, {3.2, 2.3}, {4, 2},
            {14, 2}, {14.8, 2.3}, {15.7, 3.2}, {16, 4}, {16, 8}})
    end
    D.logo     = function() Poly({{6, 19}, {6, 5}, {18, 19}, {18, 5}}) end
    D.heart    = function()
        Poly(Join(Arc(7.5, 8, 4.5, 135, 360, 14), Arc(16.5, 8, 4.5, 180, 405, 14), {{12, 20.5}}), true)
    end
    D.volume   = function()
        Poly({{4, 9}, {8, 9}, {13, 5}, {13, 19}, {8, 15}, {4, 15}}, true)
        Poly(Arc(14, 12, 5, -50, 50, 6)); Poly(Arc(14, 12, 9, -50, 50, 8))
    end
    D.external = function()
        Poly({{15, 3}, {21, 3}, {21, 9}}); Line(10, 14, 21, 3)
        Poly(Join({{18, 13}, {18, 19}}, Arc(16, 19, 2, 0, 90, 4), {{5, 21}}, Arc(5, 19, 2, 90, 180, 4),
            {{3, 8}}, Arc(5, 8, 2, 180, 270, 4), {{11, 6}}))
    end
    D.send     = function() Line(22, 2, 11, 13); Poly({{22, 2}, {15, 22}, {11, 13}, {2, 9}}, true) end
    D.power    = function() Line(12, 2, 12, 12); Poly(Arc(12, 13, 9, -45, 225, 24)) end

    ;(D[name] or D.close)()

    function obj:SetColor(c)
        for _, f in ipairs(fills) do f.BackgroundColor3 = c end
        for _, s in ipairs(strokes) do s.Color = c end
    end
    return obj
end

-- shared widgets
local function MakeToggle(parent, state, callback)
    local sw = Button({Text = "", Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -46, 0.5, -10),
        BackgroundColor3 = state and Theme.Accent or Theme.Off, Parent = parent}, {Corner(10)})
    local knob = New("Frame", {Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.Text,
        Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3), Parent = sw}, {Corner(7)})
    local T = {}
    function T:Set(v, silent)
        state = v
        Tween(sw, 0.2, {BackgroundColor3 = v and Theme.Accent or Theme.Off})
        Tween(knob, 0.2, {Position = v and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)})
        if callback and not silent then task.spawn(callback, v) end
    end
    function T:Get() return state end
    sw.MouseButton1Click:Connect(function() T:Set(not state) end)
    return T
end

local function Row(parent, text, desc, h)
    h = h or 42
    local row = New("Frame", {Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Theme.Row,
        BackgroundTransparency = 0.3, Parent = parent}, {Corner(10)})
    Label({Text = text, Font = Theme.FontBold, Position = UDim2.fromOffset(10, desc and 6 or 0),
        Size = UDim2.new(0.5, 0, 0, desc and 16 or h), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row})
    if desc then
        Label({Text = desc, TextSize = 10, TextColor3 = Theme.SubText, Position = UDim2.fromOffset(10, 22),
            Size = UDim2.new(0.5, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row})
    end
    return row
end

-- ================= LIBRARY =================
local Library = {}
Library.__index = Library
Library.IconAssets = IconAssets

function Library:Bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self.Connections, c)
    return c
end

function Library.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Library)
    self.Name         = opts.Name or "NYX UI"
    self.Edition      = opts.Edition or "Obsidian Edition"
    self.ToggleKey    = opts.ToggleKey or Enum.KeyCode.RightControl
    self.Prefix       = ";"
    self.TabButtons, self.Pages, self.Scalers = {}, {}, {}
    self.Commands, self.Quick, self.PlayerActions = {}, {}, {}
    self.Open, self.Visible, self.CurrentTab = false, true, nil
    self.Connections = {}

    -- auto scale so it fits the screen (phones)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local fitW = (vp.X * 0.94) / BASE_W
    local fitH = (vp.Y * 0.92) / (DOCK_H + 6 + PANEL_H + 12)
    self.AutoScale = math.clamp(math.floor(math.min(fitW, fitH, 1) * 100) / 100, 0.5, 1)
    self.Scale = self.AutoScale

    local old = GetParent():FindFirstChild("NyxOblivionUI")
    if old then old:Destroy() end
    self.Gui = New("ScreenGui", {Name = "NyxOblivionUI", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, Parent = GetParent()})
    self.Gui.Destroying:Connect(function()
        for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    end)

    -- root group (dock + panel). AnchorPoint top-center so scaling stays centered.
    self.Root = New("Frame", {Name = "Root", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10),
        Size = UDim2.fromOffset(BASE_W, DOCK_H), BackgroundTransparency = 1, Parent = self.Gui})
    self.RootScale = New("UIScale", {Scale = self.Scale, Parent = self.Root})
    table.insert(self.Scalers, self.RootScale)

    ---------- DOCK ----------
    local dock = New("Frame", {Name = "Dock", Size = UDim2.new(1, 0, 0, DOCK_H), BackgroundColor3 = Theme.White,
        Parent = self.Root}, {Corner(20), Stroke(Theme.Accent, 1.2, 0.3),
        Gradient(Color3.fromRGB(26, 15, 48), Color3.fromRGB(10, 6, 18), 90)})
    self.Dock = dock

    local time = Label({Text = "00:00", Font = Theme.FontBold, TextSize = 14, Position = UDim2.fromOffset(14, 5),
        Size = UDim2.fromOffset(60, 17), Parent = dock})
    local date = Label({Text = "", TextSize = 9, TextColor3 = Theme.SubText, Position = UDim2.fromOffset(14, 22),
        Size = UDim2.fromOffset(60, 12), Parent = dock})
    task.spawn(function()
        while self.Gui.Parent do
            time.Text = os.date("%H:%M"); date.Text = os.date("%a, %b %d")
            task.wait(1)
        end
    end)
    New("Frame", {Size = UDim2.fromOffset(1, 22), Position = UDim2.fromOffset(78, 9), BackgroundColor3 = Theme.Stroke,
        BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = dock})

    self.TabHolder = New("Frame", {Position = UDim2.fromOffset(84, 0), Size = UDim2.new(1, -126, 1, 0),
        BackgroundTransparency = 1, Parent = dock}, {
        New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 2),
            HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center}),
    })

    self.Chevron = Button({Text = "", TextSize = 13, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = Theme.Row, Parent = dock}, {Corner(10), Stroke()})
    self.ChevronIcon = MakeIcon("chevDown", self.Chevron, 16, Theme.Text):Center()
    self.Chevron.MouseButton1Click:Connect(function() self:SetOpen(not self.Open) end)

    ---------- PANEL ----------
    self.Panel = New("Frame", {Name = "Panel", Position = UDim2.fromOffset(0, DOCK_H + 6), Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.White, ClipsDescendants = true, Visible = false, Parent = self.Root},
        {Corner(18), Stroke(Theme.Accent, 1.2, 0.3), Gradient(Color3.fromRGB(28, 16, 50), Color3.fromRGB(9, 5, 16), 120)})

    self.Title = Label({Text = "", Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Accent2,
        Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -60, 0, 20), Parent = self.Panel})
    local closeBtn = Button({Text = "", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -32, 0, 6),
        BackgroundColor3 = Theme.Row, ZIndex = 5, Parent = self.Panel}, {Corner(12), Stroke()})
    MakeIcon("close", closeBtn, 12, Theme.Text):Center()
    closeBtn.MouseButton1Click:Connect(function() self:SetOpen(false) end)
    self.PageHolder = New("Frame", {Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -16, 1, -44),
        BackgroundTransparency = 1, Parent = self.Panel})

    ---------- DRAG DOCK ----------
    local dragging, dragStart, startPos
    dock.InputBegan:Connect(function(i)
        if IsPress(i) then dragging, dragStart, startPos = true, i.Position, self.Root.Position end
    end)
    self:Bind(UserInputService.InputChanged, function(i)
        if dragging and IsMove(i) then
            local d = i.Position - dragStart
            self.Root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    self:Bind(UserInputService.InputEnded, function(i) if IsPress(i) then dragging = false end end)

    ---------- FLOATING BUTTON (mobile show / hide) ----------
    -- "Open Nyx" pill (same idea as the Open Oblivion bar): tap = show / hide, drag = move
    self.FloatBtn = Button({Text = "", Size = UDim2.fromOffset(138, 34), Position = UDim2.new(0, 10, 0.5, -17),
        BackgroundColor3 = Theme.Bg, ZIndex = 20, Parent = self.Gui},
        {Corner(17), Stroke(Theme.Accent, 1.4, 0.15)})
    local chevBox = New("Frame", {Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(4, 4),
        BackgroundColor3 = Theme.Row, Parent = self.FloatBtn}, {Corner(9), Stroke()})
    self.FloatChev = MakeIcon("chevDown", chevBox, 14, Theme.Text):Center()
    New("Frame", {Size = UDim2.fromOffset(1, 18), Position = UDim2.fromOffset(38, 8), BackgroundColor3 = Theme.Stroke,
        BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = self.FloatBtn})
    MakeIcon("logo", self.FloatBtn, 16, Theme.Accent2).Frame.Position = UDim2.fromOffset(47, 9)
    self.FloatLabel = Label({Text = 'Close <font color="#a855f7">Nyx</font>', RichText = true, Font = Theme.FontBold,
        TextSize = 12, Position = UDim2.fromOffset(70, 0), Size = UDim2.new(1, -74, 1, 0), Parent = self.FloatBtn})
    local fd, fs, fp, moved
    self.FloatBtn.InputBegan:Connect(function(i)
        if IsPress(i) then fd, fs, fp, moved = true, i.Position, self.FloatBtn.Position, false end
    end)
    self:Bind(UserInputService.InputChanged, function(i)
        if fd and IsMove(i) then
            local d = i.Position - fs
            if d.Magnitude > 6 then moved = true end
            if moved then
                self.FloatBtn.Position = UDim2.new(fp.X.Scale, fp.X.Offset + d.X, fp.Y.Scale, fp.Y.Offset + d.Y)
            end
        end
    end)
    self:Bind(UserInputService.InputEnded, function(i)
        if fd and IsPress(i) then
            fd = false
            if not moved then self:SetVisible(not self.Visible) end
        end
    end)

    ---------- KEYS ----------
    self:Bind(UserInputService.InputBegan, function(i, gp)
        if gp then return end
        if i.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Visible)
        elseif i.UserInputType == Enum.UserInputType.Keyboard
            and UserInputService:GetStringForKeyCode(i.KeyCode) == self.Prefix and self.CommandBox then

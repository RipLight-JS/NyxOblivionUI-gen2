    return self
end

-- ================= WINDOW STATE =================
function Library:SetVisible(v)
    self.Visible = v
    self.Root.Visible = v
    if self.FloatLabel then
        self.FloatLabel.Text = (v and "Close" or "Open") .. ' <font color="#a855f7">Nyx</font>'
        Tween(self.FloatChev.Frame, 0.2, {Rotation = v and 0 or 180})
    end
end

function Library:SetOpen(v)
    self.Open = v
    Tween(self.ChevronIcon.Frame, 0.2, {Rotation = v and 180 or 0})
    if v then
        self.Panel.Visible = true
        Tween(self.Panel, 0.3, {Size = UDim2.new(1, 0, 0, PANEL_H)})
    else
        Tween(self.Panel, 0.22, {Size = UDim2.new(1, 0, 0, 0)})
        task.delay(0.23, function() if not self.Open then self.Panel.Visible = false end end)
    end
end

function Library:SetScale(v)
    self.Scale = math.clamp(v, 0.4, 1.6)
    for _, s in ipairs(self.Scalers) do s.Scale = self.Scale end
end

function Library:ResetPosition()
    self.Root.Position = UDim2.new(0.5, 0, 0, 10)
end

function Library:Notify(title, text, duration)
    local toast = New("Frame", {Size = UDim2.fromOffset(230, 48), BackgroundColor3 = Theme.Bg,
        BackgroundTransparency = 1, Parent = self.ToastHolder}, {Corner(12), Stroke(Theme.Accent, 1.2, 1), Pad(10, 6)})
    local t1 = Label({Text = title, Font = Theme.FontBold, TextSize = 12, Size = UDim2.new(1, 0, 0, 16),
        TextTransparency = 1, Parent = toast})
    local t2 = Label({Text = text, TextSize = 11, TextColor3 = Theme.SubText, Position = UDim2.fromOffset(0, 18),
        Size = UDim2.new(1, 0, 0, 16), TextTransparency = 1, TextTruncate = Enum.TextTruncate.AtEnd, Parent = toast})
    Tween(toast, 0.3, {BackgroundTransparency = 0.05}); Tween(toast.UIStroke, 0.3, {Transparency = 0.2})
    Tween(t1, 0.3, {TextTransparency = 0}); Tween(t2, 0.3, {TextTransparency = 0})
    task.delay(duration or 3, function()
        Tween(toast, 0.3, {BackgroundTransparency = 1}); Tween(toast.UIStroke, 0.3, {Transparency = 1})
        Tween(t1, 0.3, {TextTransparency = 1}); Tween(t2, 0.3, {TextTransparency = 1})
        task.wait(0.35); toast:Destroy()
    end)
end

